    "babel-eslint": "~10.1",
    "babel-loader": "~9.2",
    "css-loader": "~7.1",
    "eslint": "~9.20",
    "eslint-config-prettier": "~10.0",
    "eslint-config-wordpress": "~2.0",
    "eslint-plugin-prettier": "~5.2",
    "file-loader": "~6.2",
    "ftp-deploy": "~2.4",
    "install": "~0.13",
    "mini-css-extract-plugin": "~2.9",
    "node-sass": "~9.0",
    "prettier": "~3.5",
    "sass-loader": "~16.0",
    "style-loader": "~4.0",
    "stylelint": "~16.14",
    "stylelint-config-standard": "~37.0",
    "stylelint-config-standard-scss": "~14.0",
    "webpack": "~5.98",
    "webpack-cli": "~6.0",
