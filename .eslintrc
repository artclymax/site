{
  "root": true,
  "extends": [
      "eslint:recommended",
      "wordpress",
      "eslint-config-prettier"
    ],
    "env": {
      "browser": true,
      "node": true,
      "es6": true
    },
    "globals": {
      "google": true
    },
    "plugins": [
      "eslint-plugin-prettier"
    ],
    "parser": "babel-eslint",
    "parserOptions": {
      "ecmaVersion": 6,
      "ecmaFeatures": {
        "modules": true,
        "experimentalObjectRestSpread": true
      }
    },
    "rules": {
      "prettier/prettier": "error",
      "require-atomic-updates": 0,
      "quotes": 2,
      "no-console": "warn",
      "no-debugger": "warn",
			"space-in-parens":"off",
			"linebreak-style": ["error", "unix"],
			"camelcase":"off",
			"yoda":"off"
    }
  }
