# Editor configuration, see http://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = tab
indent_size = 2
tab_width = 2
insert_final_newline = false
trim_trailing_whitespace = true
quote_type = single
end_of_line = lf

[*.scss]
indent_style = tab
indent_size = 2

[*.js]
indent_style = tab
indent_size = 2

[*.md]
max_line_length = off
trim_trailing_whitespace = false
